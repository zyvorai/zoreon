# Greenfield self-host (Docker Compose). Copy to `.env` and edit.
# Docs: docs/CUSTOMER.md · docs/ENV.md

# --- Public URL (must match how users open the app) ---
BETTER_AUTH_URL=http://localhost:8080

# --- Secrets (required) ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-strong-db-password

# First workspace admin (must match the account you register via /join)
ZOREON_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Host port published for the app (container always listens on 8080)
ZOREON_PUBLISH_PORT=8080

# Built for compose — override only if you know what you are doing
# DATABASE_URL=postgres://zoreon:change-me-strong-db-password@db:5432/zoreon

# --- Optional: Mattermost tape ---
# MATTERMOST_URL=https://mattermost.example.com
# MATTERMOST_TOKEN=

# --- Optional: SMTP invite send ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=zoreon@example.com
# SMTP_USER=
# SMTP_PASS=
# SMTP_USE_TLS=true

# --- Optional: Web Push ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
